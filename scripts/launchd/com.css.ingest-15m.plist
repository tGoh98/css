<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CSS frequent ingest poker (every 15 min).

  Hits the Vercel /api/cron/tick-15m endpoint, which fans out to the
  news / reddit / hn ingesters. Used as an alternative to Vercel Cron
  on the Hobby plan, which caps cron frequency at daily.

  Before installing:
    1. Replace HOME_PATH below with your home directory (e.g. /Users/tgoh).
       launchd does not expand ~ or $HOME.
    2. Ensure ~/.config/css/digest.env has APP_URL and CRON_SECRET.
    3. Ensure scripts/ingest-poke.sh is executable: chmod +x.
    4. Copy to ~/Library/LaunchAgents/ and load:
         launchctl load ~/Library/LaunchAgents/com.css.ingest-15m.plist

  See LOCAL_SETUP.md for the full walkthrough.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.css.ingest-15m</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/tgoh/playground/css/scripts/ingest-poke.sh</string>
    <string>tick-15m</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>HOME_PATH</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <false/>

  <!-- Every 15 minutes. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>HOME_PATH/.local/state/css/ingest-15m-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>HOME_PATH/.local/state/css/ingest-15m-stderr.log</string>
</dict>
</plist>
